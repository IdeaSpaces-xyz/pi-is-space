{
  "name": "@ideaspaces/pi-is-space",
  "version": "0.1.51",
  "type": "module",
  "description": "Ideaspace Protocol extension for Pi — durable awareness, deliberate capture, optional sync",
  "license": "MIT",
  "homepage": "https://ideaspaces.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdeaSpaces-xyz/pi-is-space.git"
  },
  "bugs": {
    "url": "https://github.com/IdeaSpaces-xyz/pi-is-space/issues"
  },
  "keywords": [
    "pi-package",
    "ideaspaces",
    "agent-skills"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "skills",
    "reference",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build:reference": "node reference.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:tools": "node scripts/generate-tools.mjs",
    "check:tools": "node scripts/generate-tools.mjs --check"
  },
  "dependencies": {
    "@ideaspaces/cli": "github:IdeaSpaces-xyz/cli#e2f1c100f58525ef8883b4d450abcb37c715dade",
    "@ideaspaces/protocol": "github:IdeaSpaces-xyz/ideaspace-protocol#916ae9ffb2733295b04b192abc29cf3fe1b736c6",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12",
    "ajv": "^8.20.0"
  }
}
